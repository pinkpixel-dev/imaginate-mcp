# At least one provider key is required. Tools are only registered for the
# providers whose key is present.

# Enables the openai_* tools (GPT Image).
OPENAI_API_KEY=

# Enables the gemini_* tools (Nano Banana). GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Optional. Where generated images are saved.
# Default: ~/Pictures/imaginate
IMAGINATE_OUTPUT_DIR=

# Optional. Model used when a tool call does not name one.
IMAGINATE_OPENAI_MODEL=gpt-image-2
IMAGINATE_GEMINI_MODEL=gemini-3.1-flash-image

# Optional. For an OpenAI-compatible proxy or gateway.
OPENAI_BASE_URL=
